# Doctor Tracker — environment variable reference (placeholders only)
#
# Real values live exclusively in git-ignored .env files. Never commit credentials.
# Each workspace ships its own .env.example when it is scaffolded:
#   apps/api/.env.example  — added in Step 2 (API)
#   apps/web/.env.example  — added in Step 8 (frontend)
#
# Development data is synthetic only and lives in a dev database separate
# from any real data.

# ------------------------------------------------------------------
# Backend — apps/api
# ------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the Express server
API_PORT=4000

# Pino log level
LOG_LEVEL=info

# MongoDB Atlas ("web") SRV connection string — embed real credentials here.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Logical database name the app connects to on the cluster
MONGODB_DB_NAME=doctor_tracker_dev

# Admin session lifetime in minutes
AUTH_SESSION_TTL_MINUTES=480

# Comma-separated list of browser origins permitted by CORS
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# Frontend — apps/web
# ------------------------------------------------------------------

# Base URL of the REST API consumed by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
