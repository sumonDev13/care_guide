# Doctor Tracker — environment variable reference (placeholders only)
#
# The single source of runtime configuration is the git-ignored `.env` at this
# repository root, loaded by the backend (Step 2+) and frontend (Step 8+).
# Real values and credentials NEVER get committed anywhere.

# ------------------------------------------------------------------
# Backend — apps/api
# ------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the Express server
API_PORT=4000

# Pino log level
LOG_LEVEL=info

# MongoDB Atlas ("web") SRV connection string — embed real credentials here.
# REQUIRED in development and production (tests use an in-memory server
# instead). Format:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Logical database name the app connects to on the cluster (required; takes
# precedence over any URI-path database name)
MONGODB_DB_NAME=doctor_tracker_dev

# Admin session lifetime in minutes
AUTH_SESSION_TTL_MINUTES=480

# Comma-separated list of browser origins permitted by CORS
CORS_ORIGINS=http://localhost:3000

# Global API rate limiting per client IP (entries within a rolling window)
RATE_LIMIT_WINDOW_MINUTES=5
RATE_LIMIT_MAX_REQUESTS=300

# ------------------------------------------------------------------
# Frontend — apps/web
# ------------------------------------------------------------------

# Base URL of the REST API consumed by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
